# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# `.env.dev` and `.env.prod` ARE committed: they hold non-secret defaults and
# are selected by the npm scripts. Secrets go in `.env.local` (or real
# environment variables), which stay out of git.
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
tsconfig.tsbuildinfo

# editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# testing
/coverage
