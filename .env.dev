# Development configuration. Loaded by `npm run dev` and `npm run build:dev`.
#
# Committed on purpose: values here must be non-secret local defaults.
# Put anything private in `.env.local`, which is git-ignored and overrides
# this file. Real environment variables (shell, CI, container) always win.

NEXT_PUBLIC_APP_ENV=development

# Base URL the browser uses for API calls.
# Points at the Next.js rewrite in next.config.ts so requests stay
# same-origin: no CORS preflight, and cookies are sent without extra config.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Public origin of this frontend.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the Spring Boot application, used by the dev-time rewrite proxy.
# Server-side only, never exposed to the browser. Unset to disable proxying.
API_PROXY_ORIGIN=http://localhost:8080
