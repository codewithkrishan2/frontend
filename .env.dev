# Development configuration. Loaded by `npm run dev` and `npm run build:dev`.
#
# Committed on purpose: values here must be non-secret local defaults.
# Put anything private in `.env.local`, which is git-ignored and overrides
# this file. Real environment variables (shell, CI, container) always win.

NEXT_PUBLIC_APP_ENV=development

# Public origin of this frontend.
#
# The backend redirects here after GitHub OAuth (`app.frontend-url` in
# application.yml, default http://localhost:3000). If you change the port, change
# it on the backend too or sign-in will redirect to the wrong place.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the Spring Boot application.
#
# Server-side only, and intentionally not NEXT_PUBLIC_: the browser never calls
# the backend directly. All access goes through Server Components, Server Actions
# and Route Handlers, which attach the bearer token from an httpOnly cookie.
#
# This also sidesteps CORS entirely — the backend configures none.
#
# Origin only, with no path: the backend's context path (`/coderev`) is carried by
# the paths in src/lib/api/endpoints.ts, so the full base is
# http://localhost:8080/coderev/api/v1.
API_ORIGIN=http://localhost:8080
