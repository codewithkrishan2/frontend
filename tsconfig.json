{
  "compilerOptions": {
    /* Language & environment */
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    /* Next.js requires the automatic React runtime. */
    "jsx": "react-jsx",

    /* Modules — TypeScript 7 removed `baseUrl`, so `paths` are resolved
       relative to this file. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Emit — Next.js handles transpilation, tsc is type-check only */
    "noEmit": true,
    "incremental": true,

    /* Interop */
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
