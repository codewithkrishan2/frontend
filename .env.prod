# Production configuration. Loaded by `npm run build` and `npm run start`.
#
# Committed on purpose, so it must contain NO secrets. Anything sensitive
# belongs in the deployment platform's environment variables, which take
# precedence over this file.
#
# Note: NEXT_PUBLIC_* values are inlined into the client bundle at build time,
# so they must be correct when `npm run build` runs, not just at runtime.

NEXT_PUBLIC_APP_ENV=production

# Base URL the browser uses for API calls. Keep the rewrite path to stay
# same-origin, or set an absolute URL if the API is served from its own
# domain (then enable CORS on the Spring Boot side).
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Public origin of this frontend. Used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=https://example.com

# Origin of the Spring Boot application, used by the rewrite proxy.
# Server-side only, never exposed to the browser.
API_PROXY_ORIGIN=http://localhost:8080
