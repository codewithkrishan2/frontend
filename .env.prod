# Production configuration. Loaded by `npm run build` and `npm run start`.
#
# Committed on purpose, so it must contain NO secrets. Anything sensitive
# belongs in the deployment platform's environment variables, which take
# precedence over this file.
#
# Note: NEXT_PUBLIC_* values are inlined into the client bundle at build time,
# so they must be correct when `npm run build` runs, not just at runtime.

NEXT_PUBLIC_APP_ENV=production

# Public origin of this frontend. Must match the backend's `app.frontend-url`
# (FRONTEND_URL), which is where GitHub OAuth redirects back to.
NEXT_PUBLIC_SITE_URL=https://example.com

# Origin of the Spring Boot application.
#
# Server-side only, and intentionally not NEXT_PUBLIC_: the browser never calls
# the backend directly, which is what keeps tokens in httpOnly cookies and
# avoids needing CORS on the backend.
API_ORIGIN=http://localhost:8080
